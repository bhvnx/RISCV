# ── Verilator ────────────────────────────────────────────
obj_dir/

# ── Icarus Verilog ────────────────────────────────────────
*.vvp
*.vcd

# ── Toolchain build artefacts ────────────────────────────
# assembler object files
*.o
# linked ELF binaries
*.elf
# generated Verilog hex ($readmemh)
*.hex
# linker map files
*.map
# assembler listing files
*.lst

# ── Simulation logs (generated, not source) ──────────────
verif/logs/
sim/

# ── Waveforms ─────────────────────────────────────────────
*.fst
*.ghw
*.lxt
*.lxt2

# ── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── OS / editor noise ─────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/settings.json

# ── Vivado project build artefacts ────────────────────────
# Keep: vivado/*.tcl, riscv_core.xpr, and impl_1/fpga_top.bit
vivado/riscv_core_proj/riscv_core.cache/
vivado/riscv_core_proj/riscv_core.hw/
vivado/riscv_core_proj/riscv_core.ip_user_files/
vivado/riscv_core_proj/riscv_core.sim/
vivado/riscv_core_proj/riscv_core.runs/.jobs/
vivado/riscv_core_proj/riscv_core.runs/synth_1/
vivado/riscv_core_proj/riscv_core.runs/impl_1/*
!vivado/riscv_core_proj/riscv_core.runs/impl_1/fpga_top.bit
